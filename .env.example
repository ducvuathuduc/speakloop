# Planner for the simulator: auto (default: Strands tiers bedrock -> local -> rules) | rules (offline only) | bedrock | openai
SPEAKLOOP_LLM=auto
# Local tier for auto: a llama.cpp llama-server (or any OpenAI-compatible server)
SPEAKLOOP_LOCAL_LLM_URL=
# --- Amazon Bedrock (SPEAKLOOP_LLM=bedrock). Either a Bedrock API key (bearer) or the standard AWS credential chain; never commit keys.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# --- OpenAI-compatible (SPEAKLOOP_LLM=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# --- Server
HOST=127.0.0.1
PORT=8765
SPEAKLOOP_DB=speakloop.db
# Comma-separated extra Host headers allowed (e.g. a tunnel hostname)
SPEAKLOOP_ALLOWED_HOSTS=
# --- Phoneme scorer (assess_pronunciation; optional: pip install -r requirements-phoneme.txt + espeak-ng)
SPEAKLOOP_PHONEME_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
SPEAKLOOP_PHONEME_THREADS=
SPEAKLOOP_MAX_AUDIO_SECONDS=30
