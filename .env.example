# Planner provider for the simulator: rules (default, offline) | bedrock | openai
SPEAKLOOP_LLM=rules
# --- Amazon Bedrock (SPEAKLOOP_LLM=bedrock). Either a Bedrock API key (bearer) or the standard AWS credential chain; never commit keys.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# --- OpenAI-compatible (SPEAKLOOP_LLM=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# --- Server
HOST=127.0.0.1
PORT=8765
SPEAKLOOP_DB=speakloop.db
# Comma-separated extra Host headers allowed (e.g. a tunnel hostname)
SPEAKLOOP_ALLOWED_HOSTS=
